-- 1. What booking statuses exist?
SELECT status, COUNT(*) AS cnt FROM bookings GROUP BY status;

-- 2. What seat statuses exist?
SELECT status, COUNT(*) AS cnt FROM show_seats GROUP BY status;

-- 3. Are seats linked to bookings?
SELECT booking_id, COUNT(*) AS cnt FROM show_seats GROUP BY booking_id;

-- 4. Show me some confirmed bookings
SELECT id, status, seat_codes, total_amount, hold_expires_at FROM bookings WHERE status = 'CONFIRMED' LIMIT 10;

-- 5. Show me some booked seats
SELECT id, seat_code, status, booking_id, price FROM show_seats WHERE status = 'BOOKED' LIMIT 10;
